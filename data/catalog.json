  "courses": [
    {"code": "CS101", "title": "Introduction to Programming", "credits": 3, "description": "Programming fundamentals in Python: variables, control flow, functions and basic data types.", "prerequisites": []},
    {"code": "CS201", "title": "Data Structures", "credits": 3, "description": "Lists, stacks, queues, trees, hash tables and graphs, with complexity analysis.", "prerequisites": ["CS101"]},
    {"code": "CS301", "title": "Algorithms", "credits": 3, "description": "Sorting, searching, greedy algorithms, dynamic programming and graph algorithms.", "prerequisites": ["CS201"]},
    {"code": "CS305", "title": "Databases", "credits": 3, "description": "Relational modeling, SQL, normalization, indexing and transactions.", "prerequisites": ["CS201"]},
    {"code": "MATH101", "title": "Calculus I", "credits": 3, "description": "Limits, derivatives, integrals and their applications.", "prerequisites": []},
    {"code": "MATH201", "title": "Linear Algebra", "credits": 3, "description": "Vectors, matrices, linear transformations, eigenvalues and eigenvectors.", "prerequisites": ["MATH101"]},
    {"code": "MATH202", "title": "Probability and Statistics", "credits": 3, "description": "Probability, random variables, distributions, estimation and hypothesis testing.", "prerequisites": ["MATH201"]},
    {"code": "CS402", "title": "Machine Learning", "credits": 3, "description": "Supervised and unsupervised learning, model evaluation and regularization.", "prerequisites": ["CS201", "MATH202"]},
    {"code": "CS403", "title": "Deep Learning", "credits": 3, "description": "Neural networks, backpropagation, CNNs, RNNs and training practice.", "prerequisites": ["CS402"]},
    {"code": "CS410", "title": "Computer Vision", "credits": 3, "description": "Image processing, feature extraction, object detection and segmentation.", "prerequisites": ["CS402"]}
  ],
